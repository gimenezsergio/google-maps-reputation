PROJECT_NAME="Google Maps Reputation Manager"
API_V1_STR="/api/v1"
DATABASE_URL="sqlite:///./reputation.db"

# JWT Token Secret Key (Generar uno seguro en producción, ej: openssl rand -hex 32)
SECRET_KEY="replace-this-with-a-very-secure-random-hex-string-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 días

# DeepSeek API Configuration
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# Google Places API Configuration
GOOGLE_PLACES_API_KEY="your-google-places-api-key-here"

# Super Admin por defecto (usado para la inicialización)
SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD="admin123"
